# SellerPilot — environment variables
#
# Copy to .env and fill in. .env is gitignored.

# ── Required for any non-trivial usage ───────────────────────────────────
OPENAI_API_KEY=your-key-here
SECRET_KEY=founder-toolkit-shared-secret-2026

# ── Model selection ──────────────────────────────────────────────────────
AI_MODEL=gpt-5-mini

# ── Database ─────────────────────────────────────────────────────────────
# Native (host) dev with SQLite (default if unset):
# DATABASE_URL=sqlite:///./sellerpilot.db
# Docker compose: auto-set to postgresql://sellerpilot:sellerpilot@sellerpilot_postgres:5432/sellerpilot
DATABASE_URL=

# ── Postgres credentials (only consumed by docker-compose.yml) ──────────
POSTGRES_DB=sellerpilot
POSTGRES_USER=sellerpilot
# Local-dev placeholder. Override via .env or a real secret store before any deploy.
POSTGRES_PASSWORD=change-me-in-production

# ── CORS / frontend URL ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5177
ALLOWED_ORIGINS=http://localhost:5177
VITE_API_URL=http://localhost:8005/api

# ── Brain bridge (proxy questions to u-d-b's Rigby PA) ───────────────────
BRAIN_URL=http://host.docker.internal:8000
BRAIN_TOKEN=
BRAIN_CONVERSATION=

# ── Fleet signing (Session 1133 PA-chat signing back-prop) ──────────────
# Required for HMAC-signed `/api/pa/chat/` calls to u-d-b. Without
# these set, brain_client falls back to bearer-only auth and u-d-b's
# audit table records `auth_mode=bearer_only` for every PA chat call.
#
# Mint via u-d-b:
#   python manage.py provision_fleet_identity --app-slug sellerpilot
# The RAW SECRET is shown exactly ONCE — u-d-b stores only SHA256(secret).
FLEET_APP_SLUG=sellerpilot
FLEET_KEY_ID=
FLEET_SERVICE_SECRET=
